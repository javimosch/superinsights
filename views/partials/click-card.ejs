<div
  v-if="isClickEvent(row)"
  class="card bg-base-200 border border-base-300 p-3 text-xs shadow-sm space-y-2 max-w-full"
>
  <div class="flex items-center gap-2 flex-wrap">
    <span v-if="row.properties.tag" class="badge badge-sm badge-primary font-mono">&lt;{{ row.properties.tag }}&gt;</span>
    <span v-if="row.properties.id" class="badge badge-sm badge-ghost font-mono">#{{ row.properties.id }}</span>
    <span v-if="row.properties.className" class="badge badge-sm badge-ghost font-mono">.{{ row.properties.className }}</span>
  </div>
  <div v-if="row.properties.text" class="text-base-content/90 break-words" :title="row.properties.text">
    "{{ truncateText(row.properties.text, 120) }}"
  </div>
  <div v-if="row.safeHref" class="truncate">
    <a :href="row.safeHref" target="_blank" rel="noopener" class="link link-primary">{{ truncateText(row.properties.href, 80) }}</a>
  </div>
  <div v-else-if="row.properties.href" class="text-base-content/70 truncate" :title="row.properties.href">
    href: {{ truncateText(row.properties.href, 80) }}
  </div>
  <div v-if="row.properties.data && typeof row.properties.data === 'object'" class="flex flex-wrap gap-1">
    <span
      v-for="item in flattenData(row.properties.data)"
      :key="item.key"
      class="badge badge-ghost badge-sm font-mono"
      :title="'data-' + item.key + ': ' + item.value"
    >
      data-{{ item.key }}: {{ truncateText(item.value, 40) }}
    </span>
  </div>
  <div v-if="row.properties.selector" class="font-mono text-base-content/70 truncate" :title="row.properties.selector">
    {{ row.properties.selector }}
  </div>
  <div v-if="row.properties.rect && typeof row.properties.rect === 'object'" class="text-base-content/60">
    {{ row.properties.rect.x }}x{{ row.properties.rect.y }} &middot; {{ row.properties.rect.w }}x{{ row.properties.rect.h }}
  </div>
</div>
<pre v-else class="p-2 bg-base-200 rounded border border-base-300 text-xs overflow-x-auto"><code>{{ JSON.stringify(row.properties || {}, null, 2) }}</code></pre>
